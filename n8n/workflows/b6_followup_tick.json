{
  "name": "B6 followup tick (4h)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "b6-trigger",
      "name": "every 4h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8102/b6/tick",
        "options": {
          "timeout": 300000
        }
      },
      "id": "b6-call",
      "name": "glue /b6/tick",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    }
  ],
  "connections": {
    "every 4h": {
      "main": [
        [
          {
            "node": "glue /b6/tick",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Jakarta"
  },
  "active": false,
  "id": "b6-followup-tick-001"
}